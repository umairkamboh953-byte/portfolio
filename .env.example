# Markety Studio Platform Environment Configuration

# Server Port
PORT=3000

# Environment Mode (development or production)
NODE_ENV="development"

# Administrator Initial Password (Set this securely in production)
ADMIN_PASSWORD="CHANGE_ME_SECURE_ADMIN_PASSWORD_2026!"

# Session & JWT Cryptographic Secret
SESSION_SECRET="your_custom_cryptographic_secret_here_min_32_chars"

# Optional Gemini AI API Key (Injected by AI Studio if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public App Host URL (e.g. https://yourdomain.com)
APP_URL="http://localhost:3000"

# Optional Stripe Keys (When international card checkout is enabled)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
